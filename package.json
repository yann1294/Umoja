{
  "name": "umoja",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @umoja/web dev",
    "build": "pnpm --filter @umoja/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "playwright test",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
