{
  "name": "umoja",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @umoja/web dev",
    "build": "pnpm --filter @umoja/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "playwright test",
    "appwrite:validate": "pnpm --filter @umoja/appwrite appwrite:validate",
    "appwrite:provision": "pnpm --filter @umoja/appwrite appwrite:provision",
    "appwrite:drift": "pnpm --filter @umoja/appwrite appwrite:drift",
    "appwrite:health": "pnpm --filter @umoja/appwrite appwrite:health",
    "appwrite:seed": "pnpm --filter @umoja/appwrite appwrite:seed",
    "appwrite:integration": "pnpm --filter @umoja/appwrite appwrite:integration",
    "supabase:start": "supabase start",
    "supabase:status": "node scripts/supabase-health.mjs --local",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local",
    "supabase:migration:status": "supabase migration list --local",
    "supabase:types": "supabase gen types typescript --local > supabase/database.types.ts",
    "supabase:types:check": "git diff --exit-code -- supabase/database.types.ts",
    "supabase:seed": "supabase db reset --local",
    "supabase:health": "node scripts/supabase-health.mjs --local",
    "supabase:test:rls": "supabase test db --local supabase/tests/rls.sql",
    "supabase:test:storage": "supabase test db --local supabase/tests/storage.sql",
    "supabase:test:parity": "pnpm --filter @umoja/web test:unit -- --run lib/cms/repository.test.ts lib/intake/repository.test.ts lib/appwrite/encryption.test.ts",
    "supabase:test:remote-policy-smoke": "node scripts/supabase-remote-policy-smoke.mjs",
    "supabase:test:remote-policy-matrix": "node scripts/supabase-remote-policy-matrix.mjs",
    "supabase:test:remote-auth-lifecycle": "node scripts/supabase-remote-auth-lifecycle.mjs",
    "supabase:export": "supabase db dump --local --schema public --schema private --file supabase/.temp/umoja-local-schema.sql",
    "supabase:push:dev": "node scripts/supabase-push-dev.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "^5.9.3"
  }
}
