{
  "name": "@umoja/appwrite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./auth-policy": {
      "types": "./src/auth-policy.ts",
      "default": "./src/auth-policy.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./src/permissions.ts"
    }
  },
  "scripts": {
    "appwrite:validate": "node scripts/validate-config.mjs",
    "appwrite:provision": "node scripts/provision.mjs",
    "appwrite:drift": "node scripts/check-drift.mjs",
    "appwrite:health": "node scripts/health.mjs",
    "appwrite:seed": "node scripts/seed.mjs --development",
    "appwrite:integration": "node scripts/integration.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "appwrite": "^25.2.0",
    "node-appwrite": "^26.2.0",
    "zod": "4.4.3"
  }
}
